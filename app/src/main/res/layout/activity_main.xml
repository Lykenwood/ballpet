<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/eyebrow"
            android:textColor="@color/text_secondary" android:textSize="12sp" android:letterSpacing="0.12" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/title"
            android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:textSize="36sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/subtitle"
            android:textColor="@color/text_secondary" android:textSize="16sp" android:lineSpacingExtra="5dp" />
        <com.example.helloworld.EyeBallView android:id="@+id/preview_ball"
            android:layout_width="200dp" android:layout_height="200dp" android:layout_marginTop="28dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/play_hint"
            android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:gravity="center" android:text="@string/status_preview"
            android:textColor="@color/accent" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/toggle_ball" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:minHeight="56dp" android:text="@string/start_ball"
            android:backgroundTint="@color/accent" android:textColor="@android:color/white" android:textSize="16sp" />
        <Button android:id="@+id/connect_shizuku" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/connect_shizuku" android:textColor="@color/accent" android:textSize="14sp" />
        <Button android:id="@+id/go_home" style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/go_home" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <TextView android:id="@+id/source_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:padding="18dp" android:background="@drawable/hint_background"
            android:text="@string/source_hint" android:textColor="@color/text_secondary"
            android:textSize="13sp" android:lineSpacingExtra="5dp" />
    </LinearLayout>
</ScrollView>
